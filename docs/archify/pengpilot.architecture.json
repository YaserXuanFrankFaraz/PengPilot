  "cards": [
    {
      "dot": "emerald",
      "title": "流式路径",
      "items": [
        "事件泵以 120ms 帧间隔合并同种 delta，全文一次进布局",
        "Markdown 的 paint-only veil 提供渐进溶解，不触发重排",
        "推理流与文本流共享同一合并节奏"
      ]
    },
    {
      "dot": "cyan",
      "title": "数据与后台",
      "items": [
        "SQLite WAL 增量写，脏会话指纹只重写变更行",
        "检查点/分支/用量扫描全部在后台执行器",
        "帧路径只读内存缓存，零文件系统访问"
      ]
    },
    {
      "dot": "rose",
      "title": "产品差异",
      "items": [
        "Inbox/看板与象限板（work.rs）",
        "14 个 provider 驱动 + 24 个 legacy 变体",
        "无遥测、无网络面、单进程"
      ]
    }
  ]
